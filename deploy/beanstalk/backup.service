[Unit]
Description=Arm Angle private off-instance backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=webapp
Group=webapp
UMask=0077
EnvironmentFile=/etc/armangle-backup.env
ExecStart=/usr/local/libexec/armangle-manage backup-s3 --bucket ${ARMANGLE_BACKUP_BUCKET} --region ${ARMANGLE_BACKUP_REGION}
TimeoutStartSec=1800
