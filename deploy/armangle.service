[Unit]
Description=Arm Angle CV private beta
After=network.target

[Service]
User=armangle
Group=armangle
WorkingDirectory=/opt/armangle
EnvironmentFile=/etc/armangle.env
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/armangle/.venv/bin/gunicorn --config deploy/gunicorn.conf.py hosted.app:create_app()
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=armangle
StateDirectoryMode=0700
MemoryHigh=550M
MemoryMax=700M
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/armangle
TimeoutStopSec=160

[Install]
WantedBy=multi-user.target
