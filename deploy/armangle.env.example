ARMANGLE_DATA=/var/lib/armangle
ARMANGLE_ORIGIN=https://YOUR_DOMAIN
# Generate locally: python3 -c 'import secrets; print(secrets.token_hex(32))'
ARMANGLE_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Set a real public support/privacy contact before public launch.
ARMANGLE_SUPPORT_EMAIL=
# Public mode fails startup without a contact and independent deletion ledger.
ARMANGLE_PUBLIC_RELEASE=off
# Discard uploaded originals after frame extraction (default). Retaining them
# also retains audio and embedded metadata; S3 originals are opt-in.
ARMANGLE_RETAIN_ORIGINALS=off
# Private S3 bucket for opaque deletion markers, independently of snapshots.
ARMANGLE_DELETION_BUCKET=
ARMANGLE_DELETION_REGION=
# Keep practice footage unavailable until public-serving permissions are confirmed.
ARMANGLE_EXAMPLES=off
